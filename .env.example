# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Note the +psycopg — this project uses psycopg3, not the old psycopg2.
DATABASE_URL=postgresql+psycopg://bugzilla_user:bugzilla_pass@localhost:5432/bugzilla_db

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma separated list of allowed origins (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
ENVIRONMENT=development
